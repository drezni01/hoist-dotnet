<!-- Hoist.Core's package references. Also imported by Hoist.Api, so they become dependencies of the single HoistDotnet package. -->
<Project>
  <!-- Skipped in Web SDK projects (Hoist.Api), where the ASP.NET Core shared framework already provides them (NU1510). -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>
</Project>
