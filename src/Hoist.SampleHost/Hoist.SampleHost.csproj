<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>hoist-dotnet-samplehost</UserSecretsId>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core and Infra listed too: Hoist.Api references them privately, and a HoistDotnet package consumer sees all three assemblies. -->
    <ProjectReference Include="..\Hoist.Api\Hoist.Api.csproj" />
    <ProjectReference Include="..\Hoist.Core\Hoist.Core.csproj" />
    <ProjectReference Include="..\Hoist.Infra\Hoist.Infra.csproj" />
  </ItemGroup>

</Project>
