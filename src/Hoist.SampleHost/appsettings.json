{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080;http://localhost:8080",
  "CorsOrigins": [ "http://localhost:3000" ],
  "Hoist": {
    "AppCode": "sample",
    "AppName": "Sample",
    "AppVersion": "0.0.1",
    "AppBuild": "0",
    "Environment": "Development",
    "Port": 8080,
    "Database": {
      "Provider": "MySql",
      "ConnectionString": "set in user-secrets: Hoist:Database:ConnectionString (dedicated Hoist schema)",
      "Migrate": "EnsureCreated"
    },
    "Auth": {
      "UsernameClaim": "unique_name",
      "SigningKey": "set in user-secrets: Hoist:Auth:SigningKey (the Base64 key your token issuer signs with)"
    }
  }
}
